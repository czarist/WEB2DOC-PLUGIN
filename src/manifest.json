{
  "manifest_version": 3,
  "name": "Web2Doc - Conversor Inteligente",
  "version": "1.0.1",
  "description": "Exporta tabelas da web para CSV e imprime páginas",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }]
}
