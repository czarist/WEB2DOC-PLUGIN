  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild-loader": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": "^26.13.0"
  }
