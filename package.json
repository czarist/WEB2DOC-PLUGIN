{
  "name": "web2doc-plugin",
  "version": "1.0.2",
  "scripts": {
    "build": "webpack",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "version:check": "tsx scripts/check-version.ts",
    "package": "tsx scripts/package-extension.ts",
    "check": "npm run typecheck && npm run version:check && npm test && npm run build && npm run package",
    "ci": "npm ci && npm run check"
  },
