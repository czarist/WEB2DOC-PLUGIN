{
  "name": "web2doc-plugin",
  "version": "1.1.2",
  "scripts": {
    "build": "webpack",
    "dev": "tsx scripts/dev.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx tests/browser/run.mts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "version:check": "tsx scripts/check-version.ts",
    "package": "tsx scripts/package-extension.ts",
    "check": "npm run typecheck && npm run version:check && npm test && npm run build && npm run package",
    "ci": "npm ci && npm run check"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild-loader": "^4.5.0",
    "linkedom": "^0.18.15",
    "minimizer-webpack-plugin": "^5.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": "^26.13.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4",
    "tesseract.js": "^7.0.0"
  }
